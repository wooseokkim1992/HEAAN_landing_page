{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@*": ["./src"],
      "@assets/*":["src/assets/*"],
      "@components/*":["src/components/*"],
      "@constants/*":["src/constants/*"],
      "@typings/*":[
        "src/typings/*"
      ],
      "@types/*":[
        "src/types/*"
      ],
      "@utils/*":["src/utils/*"],
      "@hooks/*":["src/hooks/*"],
      "@amplify/*":["src/amplify/*"],
      "@middlewares/*":["src/middlewares/*"],
      "@state/*":["src/state/*"],
      "@api/*":["src/api/*"],
      "@app/*":["src/app/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts","./src/typings/**/*.ts","./src/types/**/*.ts" 
],
  "exclude": ["node_modules",".next"]
}
